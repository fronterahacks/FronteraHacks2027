// Cloudflare config for the Frontera Hacks 2027 site.
// Docs: https://developers.cloudflare.com/workers/static-assets/
{
  "$schema": "node_modules/wrangler/config-schema.json",
  // Worker name: also the start of the free URL,
  // frontera-hacks-2027.<your-account>.workers.dev
  "name": "frontera-hacks-2027",
  // Which version of Cloudflare's runtime behaviour to use. Pin it so
  // deploys don't change behaviour unexpectedly.
  "compatibility_date": "2026-11-01",
  "assets": {
    // Upload the built site (npm run build -> dist/). No server code: every
    // request is served straight from these files.
    "directory": "./dist",
    // Unknown paths get index.html instead of a 404 (single-page app).
    "not_found_handling": "single-page-application"
  },
  // Keep the free *.workers.dev URL on; a custom domain can be added later.
  "workers_dev": true
}
